{
  "files.exclude": {
    ".venv": true,
    "ui/node_modules": true,
    "ui/dist": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".git": true,
    ".vscode": true,
    ".gitattributes": true,
    ".gitignore": true,
    "api/__init__.py": true,
    "shared/__init__.py": true,
    "pipeline/__init__.py": true,
    "pipeline/__main__.py": true,
    "scripts": true,
    "checks": true,
    "tests": true,
    "manage.py": true,
    "requirements.txt": true,
    "api/config.py": true,
    "api/urls.py": true,
    "api/sql/one_time_indexes.sql": true,
    "ui/index.html": true,
    "ui/package.json": true,
    "ui/package-lock.json": true,
    "ui/vite.config.js": true,
    "ui/src/styles": true,
    "ui/src/lib/*.test.js": true
  },
  "explorer.compactFolders": false,
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.profiles.windows": {
    "Command Prompt": {
      "path": "${env:windir}\\System32\\cmd.exe"
    }
  },
  "editor.wordWrap": "on",
  "editor.fontSize": 16,
  "editor.lineHeight": 25,
  "editor.fontWeight": "500",
  "editor.tabSize": 4,
  "[javascriptreact]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.tabSize": 2
  }
}
